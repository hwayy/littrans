{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "packet_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Packet Id",
      "type": "string"
    },
    "stage": {
      "title": "Stage",
      "type": "string"
    },
    "batch_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
        "type": "string"
      },
      "maxItems": 9,
      "minItems": 1,
      "title": "Batch Ids",
      "type": "array"
    },
    "lens": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lens"
    },
    "host": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Host"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Dispatch model for the stage from agent_models.<host>: the value passed to the host's task launcher (alias or concrete id, host-specific), echoed by submissions. Not the served model.",
      "title": "Model"
    },
    "reasoning_effort": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Dispatched reasoning effort from agent_models.<host>, echoed by submissions.",
      "title": "Reasoning Effort"
    },
    "unit_ids": {
      "items": {
        "type": "string"
      },
      "title": "Unit Ids",
      "type": "array"
    },
    "unit_fingerprints": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Unit Fingerprints",
      "type": "object"
    },
    "batch_unit_ids": {
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "Batch Unit Ids",
      "type": "object"
    },
    "batch_context_unit_ids": {
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "Batch Context Unit Ids",
      "type": "object"
    },
    "batch_context_fingerprints": {
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$": {
          "type": "string"
        }
      },
      "title": "Batch Context Fingerprints",
      "type": "object"
    },
    "storage_root": {
      "default": "packets",
      "title": "Storage Root",
      "type": "string"
    },
    "files": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Files",
      "type": "object"
    },
    "file_sha256": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "File Sha256",
      "type": "object"
    },
    "total_bytes": {
      "minimum": 0,
      "title": "Total Bytes",
      "type": "integer"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "packet_id",
    "stage",
    "batch_ids",
    "unit_ids",
    "unit_fingerprints",
    "files",
    "total_bytes"
  ],
  "title": "WorkflowPacketManifest",
  "type": "object"
}
