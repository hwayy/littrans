{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "packet_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Packet Id",
      "type": "string"
    },
    "stage": {
      "title": "Stage",
      "type": "string"
    },
    "batch_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Batch Ids",
      "type": "array"
    },
    "lens": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lens"
    },
    "unit_ids": {
      "items": {
        "type": "string"
      },
      "title": "Unit Ids",
      "type": "array"
    },
    "unit_fingerprints": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Unit Fingerprints",
      "type": "object"
    },
    "files": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Files",
      "type": "object"
    },
    "total_bytes": {
      "minimum": 0,
      "title": "Total Bytes",
      "type": "integer"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "packet_id",
    "stage",
    "batch_ids",
    "unit_ids",
    "unit_fingerprints",
    "files",
    "total_bytes"
  ],
  "title": "WorkflowPacketManifest",
  "type": "object"
}
