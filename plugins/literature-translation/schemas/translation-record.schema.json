{
  "$defs": {
    "FigureLabel": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        }
      },
      "required": [
        "source"
      ],
      "title": "FigureLabel",
      "type": "object"
    },
    "ProjectStatus": {
      "enum": [
        "initialized",
        "extracted",
        "prepared",
        "draft",
        "qa-passed",
        "reviewed",
        "revised",
        "machine-reviewed",
        "human-approved"
      ],
      "title": "ProjectStatus",
      "type": "string"
    },
    "ReaderNote": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "accessed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessed At"
        }
      },
      "required": [
        "text"
      ],
      "title": "ReaderNote",
      "type": "object"
    },
    "TableData": {
      "additionalProperties": false,
      "properties": {
        "rows": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        },
        "header_rows": {
          "default": 1,
          "minimum": 0,
          "title": "Header Rows",
          "type": "integer"
        },
        "column_count": {
          "minimum": 1,
          "title": "Column Count",
          "type": "integer"
        }
      },
      "required": [
        "rows",
        "column_count"
      ],
      "title": "TableData",
      "type": "object"
    },
    "TermProposal": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "TermProposal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "unit_id": {
      "title": "Unit Id",
      "type": "string"
    },
    "target_text": {
      "title": "Target Text",
      "type": "string"
    },
    "target_table": {
      "anyOf": [
        {
          "$ref": "#/$defs/TableData"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "figure_labels": {
      "items": {
        "$ref": "#/$defs/FigureLabel"
      },
      "title": "Figure Labels",
      "type": "array"
    },
    "source_hash": {
      "title": "Source Hash",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "reader_note": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReaderNote"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "term_proposals": {
      "items": {
        "$ref": "#/$defs/TermProposal"
      },
      "title": "Term Proposals",
      "type": "array"
    },
    "uncertainties": {
      "items": {
        "type": "string"
      },
      "title": "Uncertainties",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/ProjectStatus",
      "default": "draft"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "unit_id",
    "target_text",
    "source_hash"
  ],
  "title": "TranslationRecord",
  "type": "object"
}
