        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Pages"
    },
    "asset_ids": {
      "items": {
        "type": "string"
      },
      "title": "Asset Ids",
      "type": "array"
    },
    "packet": {
