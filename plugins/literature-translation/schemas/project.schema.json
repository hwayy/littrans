{
  "$defs": {
    "ExternalRecheckConfig": {
      "additionalProperties": false,
      "properties": {
        "confidence_below": {
          "default": 0.9,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence Below",
          "type": "number"
        },
        "severities": {
          "items": {
            "$ref": "#/$defs/Severity"
          },
          "title": "Severities",
          "type": "array"
        }
      },
      "title": "ExternalRecheckConfig",
      "type": "object"
    },
    "ExternalReviewConfig": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "reviewer": {
          "$ref": "#/$defs/ExternalReviewerConfig"
        },
        "fallbacks": {
          "items": {
            "$ref": "#/$defs/ExternalReviewerConfig"
          },
          "title": "Fallbacks",
          "type": "array"
        },
        "recheck": {
          "$ref": "#/$defs/ExternalRecheckConfig"
        },
        "domain_expertise": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain Expertise"
        }
      },
      "required": [
        "reviewer"
      ],
      "title": "ExternalReviewConfig",
      "type": "object"
    },
    "ExternalReviewDriver": {
      "enum": [
        "claude-code",
        "antigravity",
        "cursor-cli",
        "codex-cli",
        "opencode-cli"
      ],
      "title": "ExternalReviewDriver",
      "type": "string"
    },
    "ExternalReviewerConfig": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "driver": {
          "$ref": "#/$defs/ExternalReviewDriver"
        },
        "command": {
          "title": "Command",
          "type": "string"
        },
        "model": {
          "description": "Dispatch value passed to the provider CLI's model option.",
          "title": "Model",
          "type": "string"
        },
        "model_identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Concrete model the host must report as served for `model`. Set it when `model` is a host alias (for example `sonnet`) that the host routes to another model; when unset, `model` itself is the identity that host evidence must match.",
          "title": "Model Identity"
        },
        "effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        },
        "fast": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fast"
        }
      },
      "required": [
        "id",
        "driver",
        "command",
        "model"
      ],
      "title": "ExternalReviewerConfig",
      "type": "object"
    },
    "ProjectStatus": {
      "enum": [
        "initialized",
        "extracted",
        "prepared",
        "draft",
        "qa-passed",
        "reviewed",
        "revised",
        "machine-reviewed",
        "external-reviewed",
        "human-approved"
      ],
      "title": "ProjectStatus",
      "type": "string"
    },
    "RoleDispatch": {
      "additionalProperties": false,
      "description": "One role's dispatch policy. Either field may be unset: the host's default applies.",
      "properties": {
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dispatch model for this role: the value passed to the host's task launcher (a host alias or a concrete id). Not the served model. Unset follows the host's default subagent model.",
          "title": "Model"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dispatched reasoning effort for this role, independent of every other role. Unset follows the host's default. Not applied on Claude Code, whose LitTrans agents fix their effort in their frontmatter.",
          "title": "Reasoning Effort"
        }
      },
      "title": "RoleDispatch",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "blocker",
        "major",
        "minor",
        "suggestion"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 6,
      "title": "Schema Version",
      "type": "integer"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "source_path": {
      "title": "Source Path",
      "type": "string"
    },
    "source_sha256": {
      "title": "Source Sha256",
      "type": "string"
    },
    "source_pages": {
      "title": "Source Pages",
      "type": "integer"
    },
    "profile": {
      "title": "Profile",
      "type": "string"
    },
    "record_root_relative": {
      "anyOf": [
        {
          "pattern": "^(?:\\.|\\.\\.(?:/\\.\\.)*)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Portable path from the project to its scaffold record root; absent in older projects.",
      "title": "Record Root Relative"
    },
    "source_language": {
      "default": "en",
      "title": "Source Language",
      "type": "string"
    },
    "target_language": {
      "default": "zh-CN",
      "title": "Target Language",
      "type": "string"
    },
    "rights_status": {
      "default": "private-research-only",
      "title": "Rights Status",
      "type": "string"
    },
    "external_review": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExternalReviewConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "agent_models": {
      "additionalProperties": {
        "additionalProperties": {
          "$ref": "#/$defs/RoleDispatch"
        },
        "type": "object"
      },
      "description": "Per-host role dispatch policy: translate, transcribe, audit, asset-audit and source-review, each with its own model and reasoning_effort. Each model is the dispatch value handed to that host's task launcher, a host alias or a concrete id as the host defines; which model the host serves under it is the host's own configuration and is never verified here. An unset role, model or effort is supported and follows the host's own default subagent behaviour. Claude Code takes no per-dispatch effort: the LitTrans agents' frontmatter sets it.",
      "title": "Agent Models",
      "type": "object"
    },
    "status": {
      "$ref": "#/$defs/ProjectStatus",
      "default": "initialized"
    },
    "extractor_version": {
      "default": "2",
      "title": "Extractor Version",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "title",
    "source_path",
    "source_sha256",
    "source_pages",
    "profile"
  ],
  "title": "ProjectConfig",
  "type": "object"
}
