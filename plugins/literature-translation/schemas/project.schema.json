{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 7,
      "title": "Schema Version",
      "type": "integer"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "source_path": {
      "title": "Source Path",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "source_pages": {
      "minimum": 1,
      "title": "Source Pages",
      "type": "integer"
    },
    "record_root_relative": {
      "anyOf": [
        {
          "pattern": "^(?:\\.|\\.\\.(?:/\\.\\.)*)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Record Root Relative"
    },
    "extractor_version": {
      "title": "Extractor Version",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "source_path",
    "source_sha256",
    "source_pages",
    "record_root_relative",
    "extractor_version",
    "created_at"
  ],
  "title": "ProjectManifest",
  "type": "object"
}
