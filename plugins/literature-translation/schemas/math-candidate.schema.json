{
  "$defs": {
    "MathCandidateClassification": {
      "enum": [
        "inline",
        "display",
        "mixed",
        "not-math",
        "needs-split"
      ],
      "title": "MathCandidateClassification",
      "type": "string"
    },
    "ReviewUsage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "cache_creation_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Creation Input Tokens",
          "type": "integer"
        },
        "cache_read_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Read Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "provider_turns": {
          "default": 0,
          "minimum": 0,
          "title": "Provider Turns",
          "type": "integer"
        }
      },
      "title": "ReviewUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One non-authoritative visual transcription candidate for a source unit.",
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "unit_id": {
      "title": "Unit Id",
      "type": "string"
    },
    "page": {
      "minimum": 1,
      "title": "Page",
      "type": "integer"
    },
    "source_pdf_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Pdf Sha256",
      "type": "string"
    },
    "source_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Hash",
      "type": "string"
    },
    "crop_path": {
      "title": "Crop Path",
      "type": "string"
    },
    "crop_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Crop Sha256",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "prompt_version": {
      "title": "Prompt Version",
      "type": "string"
    },
    "pass_index": {
      "default": 1,
      "maximum": 2,
      "minimum": 1,
      "title": "Pass Index",
      "type": "integer"
    },
    "classification": {
      "$ref": "#/$defs/MathCandidateClassification"
    },
    "latex": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latex"
    },
    "source_markdown": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Markdown"
    },
    "equation_number": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Equation Number"
    },
    "uncertainties": {
      "items": {
        "type": "string"
      },
      "title": "Uncertainties",
      "type": "array"
    },
    "needs_second_pass": {
      "default": false,
      "title": "Needs Second Pass",
      "type": "boolean"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "response_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Response Sha256",
      "type": "string"
    },
    "raw_response_path": {
      "title": "Raw Response Path",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/ReviewUsage"
    },
    "estimated_cost_usd": {
      "default": 0.0,
      "minimum": 0,
      "title": "Estimated Cost Usd",
      "type": "number"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "unit_id",
    "page",
    "source_pdf_sha256",
    "source_hash",
    "crop_path",
    "crop_sha256",
    "provider",
    "model",
    "prompt_version",
    "classification",
    "request_sha256",
    "response_sha256",
    "raw_response_path"
  ],
  "title": "MathCandidate",
  "type": "object"
}
