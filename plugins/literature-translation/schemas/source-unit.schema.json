{
  "$defs": {
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "path",
        "bbox"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "CalloutKind": {
      "enum": [
        "note",
        "tip",
        "warning",
        "caution",
        "whats-new"
      ],
      "title": "CalloutKind",
      "type": "string"
    },
    "FigureLabel": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        }
      },
      "required": [
        "source"
      ],
      "title": "FigureLabel",
      "type": "object"
    },
    "ParagraphData": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/ParagraphType",
          "default": "plain"
        },
        "outline_level": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outline Level"
        },
        "body_text": {
          "title": "Body Text",
          "type": "string"
        },
        "body_markdown": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body Markdown"
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParagraphLabel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "layout": {
          "$ref": "#/$defs/ParagraphLayout"
        },
        "candidates": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "body_text"
      ],
      "title": "ParagraphData",
      "type": "object"
    },
    "ParagraphLabel": {
      "additionalProperties": false,
      "properties": {
        "parts": {
          "items": {
            "$ref": "#/$defs/ParagraphLabelPart"
          },
          "minItems": 1,
          "title": "Parts",
          "type": "array"
        },
        "evidence": {
          "$ref": "#/$defs/ParagraphLabelEvidence"
        }
      },
      "required": [
        "parts",
        "evidence"
      ],
      "title": "ParagraphLabel",
      "type": "object"
    },
    "ParagraphLabelEvidence": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "glyph_ids": {
          "items": {
            "type": "string"
          },
          "title": "Glyph Ids",
          "type": "array"
        },
        "source_range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Range"
        }
      },
      "required": [
        "page"
      ],
      "title": "ParagraphLabelEvidence",
      "type": "object"
    },
    "ParagraphLabelPart": {
      "additionalProperties": false,
      "properties": {
        "part_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Part Id",
          "type": "string"
        },
        "source_text": {
          "minLength": 1,
          "title": "Source Text",
          "type": "string"
        },
        "source_markdown": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Markdown"
        },
        "policy": {
          "default": "literal",
          "enum": [
            "literal",
            "translatable"
          ],
          "title": "Policy",
          "type": "string"
        }
      },
      "required": [
        "part_id",
        "source_text"
      ],
      "title": "ParagraphLabelPart",
      "type": "object"
    },
    "ParagraphLayout": {
      "additionalProperties": false,
      "properties": {
        "left_indent_pt": {
          "default": 0,
          "title": "Left Indent Pt",
          "type": "number"
        },
        "right_indent_pt": {
          "default": 0,
          "title": "Right Indent Pt",
          "type": "number"
        },
        "first_line_offset_pt": {
          "default": 0,
          "title": "First Line Offset Pt",
          "type": "number"
        },
        "label_indent_pt": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label Indent Pt"
        },
        "label_alignment": {
          "default": "left",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "title": "Label Alignment",
          "type": "string"
        },
        "label_gap_pt": {
          "default": 3,
          "minimum": 0,
          "title": "Label Gap Pt",
          "type": "number"
        },
        "alignment": {
          "default": "left",
          "enum": [
            "left",
            "center",
            "right",
            "justify"
          ],
          "title": "Alignment",
          "type": "string"
        },
        "space_before_pt": {
          "default": 0,
          "minimum": 0,
          "title": "Space Before Pt",
          "type": "number"
        },
        "space_after_pt": {
          "default": 0,
          "minimum": 0,
          "title": "Space After Pt",
          "type": "number"
        },
        "font_size_pt": {
          "default": 12,
          "exclusiveMinimum": 0,
          "title": "Font Size Pt",
          "type": "number"
        }
      },
      "title": "ParagraphLayout",
      "type": "object"
    },
    "ParagraphType": {
      "enum": [
        "plain",
        "numbered",
        "bulleted",
        "labelled"
      ],
      "title": "ParagraphType",
      "type": "string"
    },
    "ProjectStatus": {
      "enum": [
        "initialized",
        "extracted",
        "prepared",
        "draft",
        "qa-passed",
        "reviewed",
        "revised",
        "machine-reviewed",
        "external-reviewed",
        "human-approved"
      ],
      "title": "ProjectStatus",
      "type": "string"
    },
    "RenderPolicy": {
      "enum": [
        "include",
        "omit"
      ],
      "title": "RenderPolicy",
      "type": "string"
    },
    "SemanticStatus": {
      "enum": [
        "unverified",
        "auto",
        "verified"
      ],
      "title": "SemanticStatus",
      "type": "string"
    },
    "SidebarRole": {
      "enum": [
        "title",
        "body"
      ],
      "title": "SidebarRole",
      "type": "string"
    },
    "SourceFragment": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        }
      },
      "required": [
        "page",
        "bbox"
      ],
      "title": "SourceFragment",
      "type": "object"
    },
    "TableData": {
      "additionalProperties": false,
      "properties": {
        "rows": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        },
        "header_rows": {
          "default": 1,
          "minimum": 0,
          "title": "Header Rows",
          "type": "integer"
        },
        "column_count": {
          "minimum": 1,
          "title": "Column Count",
          "type": "integer"
        }
      },
      "required": [
        "rows",
        "column_count"
      ],
      "title": "TableData",
      "type": "object"
    },
    "UnitKind": {
      "enum": [
        "paragraph",
        "note",
        "code",
        "equation",
        "figure",
        "caption",
        "table",
        "footnote",
        "bibliography"
      ],
      "title": "UnitKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 4,
      "default": 4,
      "title": "Schema Version",
      "type": "integer"
    },
    "unit_id": {
      "title": "Unit Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/UnitKind"
    },
    "page": {
      "title": "Page",
      "type": "integer"
    },
    "bbox": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Bbox",
      "type": "array"
    },
    "source_text": {
      "title": "Source Text",
      "type": "string"
    },
    "source_hash": {
      "title": "Source Hash",
      "type": "string"
    },
    "asset_content_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Asset Content Hashes",
      "type": "object"
    },
    "source_markdown": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Markdown"
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Id"
    },
    "paragraph": {
      "anyOf": [
        {
          "$ref": "#/$defs/ParagraphData"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "paragraph_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Paragraph Id"
    },
    "item_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Item Id"
    },
    "parent_item_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Item Id"
    },
    "container_role": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Container Role"
    },
    "section_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Section Id"
    },
    "sidebar_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sidebar Id"
    },
    "sidebar_role": {
      "anyOf": [
        {
          "$ref": "#/$defs/SidebarRole"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "callout_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/CalloutKind"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "translatable": {
      "default": true,
      "title": "Translatable",
      "type": "boolean"
    },
    "render_policy": {
      "$ref": "#/$defs/RenderPolicy",
      "default": "include"
    },
    "protected_tokens": {
      "items": {
        "type": "string"
      },
      "title": "Protected Tokens",
      "type": "array"
    },
    "asset_refs": {
      "items": {
        "$ref": "#/$defs/AssetRef"
      },
      "title": "Asset Refs",
      "type": "array"
    },
    "fragments": {
      "items": {
        "$ref": "#/$defs/SourceFragment"
      },
      "title": "Fragments",
      "type": "array"
    },
    "latex": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latex"
    },
    "equation_number": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Equation Number"
    },
    "equation_numbers": {
      "items": {
        "type": "string"
      },
      "title": "Equation Numbers",
      "type": "array"
    },
    "footnote_number": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Footnote Number"
    },
    "footnote_refs": {
      "items": {
        "type": "string"
      },
      "title": "Footnote Refs",
      "type": "array"
    },
    "math_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/SemanticStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "code_language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code Language"
    },
    "table": {
      "anyOf": [
        {
          "$ref": "#/$defs/TableData"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "continues_from_previous": {
      "default": false,
      "title": "Continues From Previous",
      "type": "boolean"
    },
    "continued_to_next": {
      "default": false,
      "title": "Continued To Next",
      "type": "boolean"
    },
    "figure_labels": {
      "items": {
        "$ref": "#/$defs/FigureLabel"
      },
      "title": "Figure Labels",
      "type": "array"
    },
    "visual_text_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/SemanticStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "verification_status": {
      "$ref": "#/$defs/SemanticStatus",
      "default": "unverified"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "status": {
      "$ref": "#/$defs/ProjectStatus",
      "default": "extracted"
    }
  },
  "required": [
    "unit_id",
    "kind",
    "page",
    "bbox",
    "source_text",
    "source_hash",
    "confidence"
  ],
  "title": "SourceUnit",
  "type": "object"
}
