{
  "$defs": {
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "path",
        "bbox"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "FigureLabel": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        }
      },
      "required": [
        "source"
      ],
      "title": "FigureLabel",
      "type": "object"
    },
    "ProjectStatus": {
      "enum": [
        "initialized",
        "extracted",
        "prepared",
        "draft",
        "qa-passed",
        "reviewed",
        "revised",
        "machine-reviewed",
        "human-approved"
      ],
      "title": "ProjectStatus",
      "type": "string"
    },
    "RenderPolicy": {
      "enum": [
        "include",
        "omit"
      ],
      "title": "RenderPolicy",
      "type": "string"
    },
    "SemanticStatus": {
      "enum": [
        "unverified",
        "auto",
        "verified"
      ],
      "title": "SemanticStatus",
      "type": "string"
    },
    "SourceFragment": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        }
      },
      "required": [
        "page",
        "bbox"
      ],
      "title": "SourceFragment",
      "type": "object"
    },
    "TableData": {
      "additionalProperties": false,
      "properties": {
        "rows": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        },
        "header_rows": {
          "default": 1,
          "minimum": 0,
          "title": "Header Rows",
          "type": "integer"
        },
        "column_count": {
          "minimum": 1,
          "title": "Column Count",
          "type": "integer"
        }
      },
      "required": [
        "rows",
        "column_count"
      ],
      "title": "TableData",
      "type": "object"
    },
    "UnitKind": {
      "enum": [
        "heading",
        "paragraph",
        "list_item",
        "note",
        "code",
        "equation",
        "figure",
        "caption",
        "table",
        "footnote",
        "bibliography"
      ],
      "title": "UnitKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "unit_id": {
      "title": "Unit Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/UnitKind"
    },
    "page": {
      "title": "Page",
      "type": "integer"
    },
    "bbox": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Bbox",
      "type": "array"
    },
    "source_text": {
      "title": "Source Text",
      "type": "string"
    },
    "source_hash": {
      "title": "Source Hash",
      "type": "string"
    },
    "source_markdown": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Markdown"
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Id"
    },
    "translatable": {
      "default": true,
      "title": "Translatable",
      "type": "boolean"
    },
    "render_policy": {
      "$ref": "#/$defs/RenderPolicy",
      "default": "include"
    },
    "protected_tokens": {
      "items": {
        "type": "string"
      },
      "title": "Protected Tokens",
      "type": "array"
    },
    "asset_refs": {
      "items": {
        "$ref": "#/$defs/AssetRef"
      },
      "title": "Asset Refs",
      "type": "array"
    },
    "fragments": {
      "items": {
        "$ref": "#/$defs/SourceFragment"
      },
      "title": "Fragments",
      "type": "array"
    },
    "latex": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latex"
    },
    "equation_number": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Equation Number"
    },
    "math_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/SemanticStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "code_language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code Language"
    },
    "table": {
      "anyOf": [
        {
          "$ref": "#/$defs/TableData"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "continues_from_previous": {
      "default": false,
      "title": "Continues From Previous",
      "type": "boolean"
    },
    "continued_to_next": {
      "default": false,
      "title": "Continued To Next",
      "type": "boolean"
    },
    "figure_labels": {
      "items": {
        "$ref": "#/$defs/FigureLabel"
      },
      "title": "Figure Labels",
      "type": "array"
    },
    "visual_text_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/SemanticStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "verification_status": {
      "$ref": "#/$defs/SemanticStatus",
      "default": "unverified"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "status": {
      "$ref": "#/$defs/ProjectStatus",
      "default": "extracted"
    }
  },
  "required": [
    "unit_id",
    "kind",
    "page",
    "bbox",
    "source_text",
    "source_hash",
    "confidence"
  ],
  "title": "SourceUnit",
  "type": "object"
}
