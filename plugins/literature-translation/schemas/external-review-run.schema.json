{
  "$defs": {
    "ExternalReviewDriver": {
      "enum": [
        "claude-code",
        "antigravity"
      ],
      "title": "ExternalReviewDriver",
      "type": "string"
    },
    "ExternalReviewVerdict": {
      "enum": [
        "accepted",
        "changes-requested",
        "inconclusive"
      ],
      "title": "ExternalReviewVerdict",
      "type": "string"
    },
    "PromptDelivery": {
      "enum": [
        "stdin",
        "file"
      ],
      "title": "PromptDelivery",
      "type": "string"
    },
    "ReviewScope": {
      "enum": [
        "full",
        "incremental"
      ],
      "title": "ReviewScope",
      "type": "string"
    },
    "ReviewUsage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "cache_creation_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Creation Input Tokens",
          "type": "integer"
        },
        "cache_read_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Read Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "provider_turns": {
          "default": 0,
          "minimum": 0,
          "title": "Provider Turns",
          "type": "integer"
        }
      },
      "title": "ReviewUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "batch_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Batch Id",
      "type": "string"
    },
    "reviewer_id": {
      "title": "Reviewer Id",
      "type": "string"
    },
    "driver": {
      "$ref": "#/$defs/ExternalReviewDriver"
    },
    "role": {
      "title": "Role",
      "type": "string"
    },
    "requested_model": {
      "title": "Requested Model",
      "type": "string"
    },
    "actual_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actual Model"
    },
    "actual_model_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actual Model Label"
    },
    "model_verified": {
      "default": false,
      "title": "Model Verified",
      "type": "boolean"
    },
    "cli_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cli Version"
    },
    "effort": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effort"
    },
    "fast_mode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fast Mode"
    },
    "translation_fingerprint": {
      "title": "Translation Fingerprint",
      "type": "string"
    },
    "packet_sha256": {
      "title": "Packet Sha256",
      "type": "string"
    },
    "prompt_version": {
      "title": "Prompt Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ReviewScope",
      "default": "full"
    },
    "base_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Run Id"
    },
    "covered_unit_ids": {
      "items": {
        "type": "string"
      },
      "title": "Covered Unit Ids",
      "type": "array"
    },
    "unit_fingerprints": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Unit Fingerprints",
      "type": "object"
    },
    "source_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Fingerprint"
    },
    "structure_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Structure Fingerprint"
    },
    "context_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Fingerprint"
    },
    "duration_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Seconds"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewUsage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cost_usd": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Usd"
    },
    "prompt_delivery": {
      "$ref": "#/$defs/PromptDelivery",
      "default": "file"
    },
    "verdict": {
      "$ref": "#/$defs/ExternalReviewVerdict"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "issue_ids": {
      "items": {
        "type": "string"
      },
      "title": "Issue Ids",
      "type": "array"
    },
    "response_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Path"
    },
    "attempts": {
      "default": 1,
      "minimum": 1,
      "title": "Attempts",
      "type": "integer"
    },
    "failure_type": {
      "anyOf": [
        {
          "enum": [
            "authentication",
            "network",
            "format",
            "model",
            "timeout",
            "provider",
            "unknown"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Type"
    },
    "fallback_of": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Of"
    },
    "attempt_log_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempt Log Path"
    },
    "success": {
      "default": true,
      "title": "Success",
      "type": "boolean"
    },
    "reviewed_at": {
      "title": "Reviewed At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "batch_id",
    "reviewer_id",
    "driver",
    "role",
    "requested_model",
    "translation_fingerprint",
    "packet_sha256",
    "prompt_version",
    "verdict",
    "summary"
  ],
  "title": "ExternalReviewRun",
  "type": "object"
}
