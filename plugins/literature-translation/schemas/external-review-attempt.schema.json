{
  "$defs": {
    "ExternalReviewDriver": {
      "enum": [
        "claude-code",
        "antigravity"
      ],
      "title": "ExternalReviewDriver",
      "type": "string"
    },
    "PromptDelivery": {
      "enum": [
        "stdin",
        "file"
      ],
      "title": "PromptDelivery",
      "type": "string"
    },
    "ReviewUsage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "cache_creation_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Creation Input Tokens",
          "type": "integer"
        },
        "cache_read_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Read Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "provider_turns": {
          "default": 0,
          "minimum": 0,
          "title": "Provider Turns",
          "type": "integer"
        }
      },
      "title": "ReviewUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One provider invocation attempt, including targeted format-repair attempts.",
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "batch_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Batch Id",
      "type": "string"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "reviewer_id": {
      "title": "Reviewer Id",
      "type": "string"
    },
    "driver": {
      "$ref": "#/$defs/ExternalReviewDriver"
    },
    "requested_model": {
      "title": "Requested Model",
      "type": "string"
    },
    "actual_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actual Model"
    },
    "effort": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effort"
    },
    "prompt_delivery": {
      "$ref": "#/$defs/PromptDelivery"
    },
    "duration_seconds": {
      "minimum": 0,
      "title": "Duration Seconds",
      "type": "number"
    },
    "success": {
      "title": "Success",
      "type": "boolean"
    },
    "failure_type": {
      "anyOf": [
        {
          "enum": [
            "authentication",
            "network",
            "format",
            "model",
            "timeout",
            "provider",
            "unknown"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Type"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "targeted_repair_scheduled": {
      "default": false,
      "title": "Targeted Repair Scheduled",
      "type": "boolean"
    },
    "usage": {
      "$ref": "#/$defs/ReviewUsage"
    },
    "cost_usd": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Usd"
    },
    "raw_response_path": {
      "title": "Raw Response Path",
      "type": "string"
    },
    "recorded_at": {
      "title": "Recorded At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "batch_id",
    "attempt",
    "reviewer_id",
    "driver",
    "requested_model",
    "prompt_delivery",
    "duration_seconds",
    "success",
    "raw_response_path"
  ],
  "title": "ExternalReviewAttempt",
  "type": "object"
}
